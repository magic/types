{
  "name": "@magic/types",
  "version": "0.1.40",
  "description": "typechecking library",
  "keywords": [
    "magic",
    "typechecking",
    "types"
  ],
  "homepage": "https://github.com/magic/types",
  "bugs": {
    "url": "https://github.com/magic/types/issues"
  },
  "license": "AGPL-3.0",
  "author": "Wizards & Witches",
  "contributors": [
    {
      "name": "jascha ehrenreich",
      "github": "jaeh"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic/types.git"
  },
  "files": [
    "src",
    "types"
  ],
  "type": "module",
  "main": "src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "import": "./src/index.js",
      "types": "./types/index.d.ts"
    }
  },
  "scripts": {
    "start": "t",
    "build": "tsc && npm run format",
    "prepublishOnly": "npm run test && npm run build",
    "build:docs": "NODE_ENV=production magic build",
    "prod": "NODE_ENV=production magic build serve",
    "clean": "magic clean",
    "serve": "magic serve",
    "dev": "magic dev",
    "test": "t",
    "format": "f -w --exclude docs",
    "format:check": "f --exclude docs",
    "calls": "calls",
    "tsc": "tsc --noEmit",
    "tsc:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "lint",
    "check": "npm run tsc && npm run tsc:test && npm run lint"
  },
  "devDependencies": {
    "@magic-modules/git-badges": "0.0.12",
    "@magic-modules/light-switch": "0.0.12",
    "@magic-modules/no-spy": "0.0.9",
    "@magic-modules/pre": "0.0.12",
    "@magic-themes/docs": "0.0.15",
    "@magic/core": "0.0.161",
    "@magic/format": "0.0.79",
    "@magic/lint": "0.0.5",
    "@magic/test": "0.3.55",
    "@types/node": "26.6.6",
    "typescript": "npm:@typescript/typescript6"
  },
  "engines": {
    "node": ">=18"
  },
  "engineStrict": true,
  "allowScripts": {
    "canvas@3.2.3": true,
    "@swc/core@1.15.47": true
  }
}
